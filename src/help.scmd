// +N help entries, one function per menu item (alias scmd_h_N).

export function scmd_h_1()
{
    console.print("--------------------------------");
    console.print("[SCMD] 快捷指令");
    console.print("命令: scmd_quick");
    console.print("说明: 执行或打开: 快捷指令");
    console.print("提示: 输入 00 可刷新当前菜单");
    console.print("--------------------------------");
}

