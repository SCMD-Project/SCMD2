export function scmd_help_help()
{
    screen_begin();
    reset_slots();
    console.print("================================");
    console.print("=|SCMD 2.0:\\CFG与控制台\\命令帮助");
    console.print("================================");
    console.print("=控制台用法:");
    console.print("=help <command>");
    console.print("");
    console.print("=例如: help bot_place");
    console.print("================================");
    console.print("=0.返回");
    console.print("=00.刷新");
    console.print("=+序号.查看指令/用法");
    console.print("================================");
    command.exec("alias 0 scmd_cfg");
    command.exec("alias 00 scmd_help_help");
}

