// Command catalog pages (static text).

export function scmd_cmd_cfg()
{
    screen_begin();
    reset_slots();
    console.print("================================");
    console.print("=|SCMD 2.0:\\菜单\\全部命令\\CFG与控制台");
    console.print("================================");
    console.print("=alias - 定义别名");
    console.print("=exec - 执行CFG");
    console.print("=execifexists - 存在时执行CFG");
    console.print("=exec_async - 异步执行 [CHEATS]");
    console.print("=clear / clearall - 清屏");
    console.print("=echo / echoln - 输出文本");
    console.print("=find / findflags - 搜索命令");
    console.print("=help - 查询帮助");
    console.print("=grep - 过滤输出");
    console.print("=cvarlist - 命令与ConVar列表");
    console.print("=differences - 非默认ConVar");
    console.print("=print_changed_convars - 已修改ConVar");
    console.print("=toggle / cyclevar - 切换值");
    console.print("=incrementvar / multvar - 数值操作");
    console.print("=push_var_values / pop_var_values - 保存恢复值");
    console.print("=host_writeconfig - 保存配置");
    console.print("=writekeybindings - 保存按键");
    console.print("================================");
    console.print("=0.返回");
    console.print("=00.刷新");
    console.print("=+序号.查看指令/用法");
    console.print("================================");
    command.exec("alias 0 scmd_commands");
    command.exec("alias 00 scmd_cmd_cfg");
}

