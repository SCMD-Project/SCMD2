export function scmd_pref_clear()
{
    if(pref_clear_mode == 0)
    {
        pref_clear_mode = 1;
    }
    else if(pref_clear_mode == 1)
    {
        pref_clear_mode = 2;
    }
    else
    {
        pref_clear_mode = 0;
    }
    command.exec("scmd_preferences");
}

export function scmd_pref_tips()
{
    if(pref_tips)
    {
        pref_tips = false;
    }
    else
    {
        pref_tips = true;
    }
    command.exec("scmd_preferences");
}

export function scmd_pref_reset()
{
    pref_clear_mode = 1;
    pref_tips = true;
    command.exec("scmd_preferences");
}
