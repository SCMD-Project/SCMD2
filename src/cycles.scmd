export function scmd_volume_cycle()
{
    if(st_volume == 1)
    {
        command.exec("volume 0.25");
        st_volume = 2;
    }
    else if(st_volume == 2)
    {
        command.exec("volume 0.5");
        st_volume = 3;
    }
    else if(st_volume == 3)
    {
        command.exec("volume 0.75");
        st_volume = 4;
    }
    else if(st_volume == 4)
    {
        command.exec("volume 1");
        st_volume = 5;
    }
    else if(st_volume == 5)
    {
        command.exec("volume 0");
        st_volume = 1;
    }
    else
    {
        command.exec("volume 0");
        st_volume = 1;
    }
}

