// Parameter preset cycles (public scmd_* never force a page render).

export function scmd_timescale()
{
    if(st_timescale == 1)
    {
        command.exec("host_timescale 0.25");
        st_timescale = 2;
    }
    else if(st_timescale == 2)
    {
        command.exec("host_timescale 0.5");
        st_timescale = 3;
    }
    else if(st_timescale == 3)
    {
        command.exec("host_timescale 1");
        st_timescale = 4;
    }
    else if(st_timescale == 4)
    {
        command.exec("host_timescale 2");
        st_timescale = 5;
    }
    else if(st_timescale == 5)
    {
        command.exec("host_timescale 0.1");
        st_timescale = 1;
    }
    else
    {
        command.exec("host_timescale 0.1");
        st_timescale = 1;
    }
}

