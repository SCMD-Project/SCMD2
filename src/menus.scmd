export function scmd_weapons_all()
{
    screen_begin();
    reset_slots();
    console.print("================================");
    console.print("=|SCMD 2.0:\\武器与装备\\全部武器");
    console.print("================================");
    console.print("=1.AK-47");
    console.print("=2.M4A4");
