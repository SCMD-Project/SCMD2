// Menu pages: print rows, bind numeric/+N slots, then rebind 0/00.

export function scmd_menu()
{
    screen_begin();
    reset_slots();
    console.print("================================");
    console.print("=|SCMD 2.0:\\菜单");
    console.print("================================");
    console.print("=指令:");
    console.print("=1.快捷指令");
    console.print("=2.全部命令");
    console.print("=3.武器与装备");
    console.print("=4.自定义指令");
    console.print("");
    console.print("=练习:");
    console.print("=5.快速跑图");
    console.print("=6.练习工具");
    console.print("=7.人机控制");
    console.print("=8.Demo与观战");
    console.print("");
    console.print("=设置:");
    console.print("=9.地图与会话");
    console.print("=10.显示与HUD");
    console.print("=11.准星与视角");
    console.print("=12.声音与语音");
    console.print("=13.按键与快捷键");
    console.print("=14.CFG与控制台");
    console.print("");
    console.print("=SCMD:");
    console.print("=15.首选项");
    console.print("=16.关于SCMD");
    console.print("");
    console.print("================================");
    console.print("=0.返回");
    console.print("=00.刷新");
    console.print("=+序号.查看指令/用法");
    console.print("================================");
    command.exec("alias 0 scmd_menu");
    command.exec("alias 00 scmd_menu");
    command.exec("alias 1 scmd_quick");
    command.exec("alias +1 scmd_h_1");
    command.exec("alias 2 scmd_commands");
    command.exec("alias +2 scmd_h_2");
    command.exec("alias 3 scmd_weapons");
    command.exec("alias +3 scmd_h_3");
    command.exec("alias 4 scmd_custom_menu");
    command.exec("alias +4 scmd_h_4");
    command.exec("alias 5 scmd_practice");
    command.exec("alias +5 scmd_h_5");
    command.exec("alias 6 scmd_practice_tools");
    command.exec("alias +6 scmd_h_6");
    command.exec("alias 7 scmd_bots");
    command.exec("alias +7 scmd_h_7");
    command.exec("alias 8 scmd_demo");
    command.exec("alias +8 scmd_h_8");
    command.exec("alias 9 scmd_map");
    command.exec("alias +9 scmd_h_9");
    command.exec("alias 10 scmd_display");
    command.exec("alias +10 scmd_h_10");
    command.exec("alias 11 scmd_crosshair_menu");
    command.exec("alias +11 scmd_h_11");
    command.exec("alias 12 scmd_sound");
    command.exec("alias +12 scmd_h_12");
    command.exec("alias 13 scmd_bind");
    command.exec("alias +13 scmd_h_13");
    command.exec("alias 14 scmd_cfg");
    command.exec("alias +14 scmd_h_14");
    command.exec("alias 15 scmd_preferences");
    command.exec("alias +15 scmd_h_15");
    command.exec("alias 16 scmd_about");
    command.exec("alias +16 scmd_h_16");
}

export function scmd_quick()
{
    screen_begin();
    reset_slots();
    console.print("================================");
    console.print("=|SCMD 2.0:\\菜单\\快捷指令");
    console.print("================================");
    console.print("=常用:");
    console.print("=1.清空控制台");
    console.print("=2.断开当前服务器");
    console.print("=3.打开购买菜单");
    console.print("=4.打开队伍菜单");
    console.print("=5.切换左右手");
    console.print("");
    console.print("=练习:");
    console.print("=6.切换飞行");
    console.print("=7.重新投掷上一个投掷物");
    console.print("=8.放置人机");
    console.print("=9.冻结/解除人机");
    console.print("=10.清除全部人机");
    console.print("=11.重新开始回合");
    console.print("=12.结束热身");
    console.print("");
    console.print("=显示:");
    row_quick_fps();
    row_quick_impacts();
    row_quick_trajectory();
    row_quick_showpos();
    console.print("");
    console.print("================================");
    console.print("=0.返回");
    console.print("=00.刷新");
    console.print("=+序号.查看指令/用法");
    console.print("================================");
    command.exec("alias 0 scmd_menu");
    command.exec("alias 00 scmd_quick");
    command.exec("alias 1 scmd_clear");
    command.exec("alias +1 scmd_h_17");
    command.exec("alias 2 scmd_disconnect");
    command.exec("alias +2 scmd_h_18");
    command.exec("alias 3 scmd_buymenu");
    command.exec("alias +3 scmd_h_19");
    command.exec("alias 4 scmd_teammenu");
    command.exec("alias +4 scmd_h_20");
    command.exec("alias 5 scmd_switchhands");
    command.exec("alias +5 scmd_h_21");
    command.exec("alias 6 scmd_noclip");
    command.exec("alias +6 scmd_h_22");
    command.exec("alias 7 scmd_rethrow");
    command.exec("alias +7 scmd_h_23");
    command.exec("alias 8 scmd_bot_place");
    command.exec("alias +8 scmd_h_24");
    command.exec("alias 9 scmd_bot_freeze");
    command.exec("alias +9 scmd_h_25");
    command.exec("alias 10 scmd_bot_clear");
    command.exec("alias +10 scmd_h_26");
    command.exec("alias 11 scmd_round_restart");
    command.exec("alias +11 scmd_h_27");
    command.exec("alias 12 scmd_warmup_end");
    command.exec("alias +12 scmd_h_28");
    command.exec("alias 13 scmd_i_quick_fps");
    command.exec("alias +13 scmd_h_29");
    command.exec("alias 14 scmd_i_quick_impacts");
    command.exec("alias +14 scmd_h_30");
    command.exec("alias 15 scmd_i_quick_trajectory");
    command.exec("alias +15 scmd_h_31");
    command.exec("alias 16 scmd_i_quick_showpos");
    command.exec("alias +16 scmd_h_32");
}

