function screen_begin()
{
    if(pref_clear_mode == 1)
    {
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
        console.print("");
    }
    else if(pref_clear_mode == 2)
    {
        console.clear();
    }
}

