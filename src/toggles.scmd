// Binary state toggles (public scmd_* never force a page render).

export function scmd_fps()
{
    if(st_fps == 2)
    {
        command.exec("cl_showfps 0");
        st_fps = 1;
        if(pref_tips)
        {
            console.print("[SCMD] FPS显示: OFF");
        }
    }
    else
    {
        command.exec("cl_showfps 1");
        st_fps = 2;
        if(pref_tips)
        {
            console.print("[SCMD] FPS显示: ON");
        }
    }
}

