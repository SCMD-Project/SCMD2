export function scmd_ammo()
{
    if(st_ammo == 2)
    {
        command.exec("sv_infinite_ammo 1");
        st_ammo = 3;
    }
    else if(st_ammo == 3)
    {
        command.exec("sv_infinite_ammo 0");
        st_ammo = 1;
    }
    else
    {
        command.exec("sv_infinite_ammo 2");
        st_ammo = 2;
    }
    if(pref_tips)
    {
        if(st_ammo == 3)
        {
            console.print("[SCMD] 无限弹药: 无限");
        }
        else if(st_ammo == 2)
        {
            console.print("[SCMD] 无限弹药: 换弹");
        }
        else
        {
            console.print("[SCMD] 无限弹药: OFF");
        }
    }
}
