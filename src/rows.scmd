// Independent per-row renderers; pages only compose rows, so N dynamic rows stay O(N).

function row_quick_fps()
{
    if(st_fps == 2)
    {
        console.print("=13.FPS显示 [ON]");
    }
    else if(st_fps == 1)
    {
        console.print("=13.FPS显示 [OFF]");
    }
    else
    {
        console.print("=13.FPS显示 [?]");
    }
}

