export function scmd_i_bind_key_1()
{
    if(bind_target == 1)
    {
        command.exec("bind f1 scmd_menu");
    }
    else if(bind_target == 2)
    {
        command.exec("bind f1 scmd_quick");
    }
    else if(bind_target == 3)
    {
        command.exec("bind f1 scmd_practice");
    }
    else if(bind_target == 4)
    {
        command.exec("bind f1 scmd_practice_tools");
    }
    else if(bind_target == 5)
    {
        command.exec("bind f1 scmd_bots");
    }
    else if(bind_target == 6)
    {
        command.exec("bind f1 scmd_weapons");
    }
    else if(bind_target == 7)
    {
        command.exec("bind f1 scmd_noclip");
    }
    else if(bind_target == 8)
    {
        command.exec("bind f1 scmd_rethrow");
    }
    else if(bind_target == 9)
    {
        command.exec("bind f1 scmd_bot_place");
    }
    else if(bind_target == 10)
    {
        command.exec("bind f1 scmd_bot_freeze");
    }
    else if(bind_target == 11)
    {
        command.exec("bind f1 scmd_bot_mimic");
    }
    else if(bind_target == 12)
    {
        command.exec("bind f1 scmd_bot_clear");
    }
    else if(bind_target == 13)
    {
        command.exec("bind f1 scmd_fps");
    }
    else if(bind_target == 14)
    {
        command.exec("bind f1 scmd_impacts");
    }
    else if(bind_target == 15)
    {
        command.exec("bind f1 scmd_trajectory");
    }
    else if(bind_target == 16)
    {
        command.exec("bind f1 scmd_showpos");
    }
    else if(bind_target == 17)
    {
        command.exec("bind f1 scmd_ammo");
    }
    else if(bind_target == 18)
    {
        command.exec("bind f1 scmd_god");
    }
    else if(bind_target == 19)
    {
        command.exec("bind f1 scmd_smoke_clear");
    }
    else if(bind_target == 20)
    {
        command.exec("bind f1 scmd_round_restart");
    }
    else if(bind_target == 21)
    {
        command.exec("bind f1 scmd_warmup_end");
    }
    else if(bind_target == 22)
    {
        command.exec("bind f1 scmd_demo_pause");
    }
    else if(bind_target == 23)
    {
        command.exec("bind f1 scmd_crosshair");
    }
    else if(bind_target == 24)
    {
        command.exec("bind f1 scmd_voice_toggle");
    }
    else if(bind_target == 25)
    {
        command.exec("bind f1 scmd_custom1");
    }
    else if(bind_target == 26)
    {
        command.exec("bind f1 scmd_custom2");
    }
    else if(bind_target == 27)
    {
        command.exec("bind f1 scmd_custom3");
    }
    else if(bind_target == 28)
    {
        command.exec("bind f1 scmd_custom4");
    }
    else if(bind_target == 29)
    {
        command.exec("bind f1 scmd_custom5");
    }
    else if(bind_target == 30)
    {
        command.exec("bind f1 scmd_custom6");
    }
    else if(bind_target == 31)
    {
        command.exec("bind f1 scmd_custom7");
    }
    else if(bind_target == 32)
    {
        command.exec("bind f1 scmd_custom8");
    }
    command.exec("scmd_bind");
    if(pref_tips)
    {
        console.print("[SCMD] 已绑定 F1");
    }
}

