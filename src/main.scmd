    {
        command.exec("cl_crosshairgap 0");
        st_cross_gap = 3;
    }
    else if(st_cross_gap == 3)
    {
        command.exec("cl_crosshairgap 1");
        st_cross_gap = 4;
    }
    else if(st_cross_gap == 4)
    {
        command.exec("cl_crosshairgap 3");
        st_cross_gap = 5;
    }
    else if(st_cross_gap == 5)
    {
        command.exec("cl_crosshairgap -3");
        st_cross_gap = 1;
    }
    else
    {
        command.exec("cl_crosshairgap -3");
        st_cross_gap = 1;
    }
}

