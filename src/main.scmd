// fn[592] pref_cycle_clear -> scmd_pref_clear
function pref_cycle_clear()
{
    if(pref_clear_mode == 0)
    {
        pref_clear_mode = 1;
    }
    else if(pref_clear_mode == 1)
    {
        pref_clear_mode = 2;
    }
    else
    {
        pref_clear_mode = 0;
    }
    command.exec("scmd_preferences");
}

// fn[593] pref_toggle_tips -> scmd_pref_tips
function pref_toggle_tips()
{
    if(pref_tips)
    {
        pref_tips = false;
    }
    else
    {
        pref_tips = true;
    }
    command.exec("scmd_preferences");
}

// fn[594] pref_reset -> scmd_pref_reset
function pref_reset()
{
    pref_clear_mode = 1;
    pref_tips = true;
    command.exec("scmd_preferences");
}

// fn[595] row_pref_clear
function row_pref_clear()
{
    if(pref_clear_mode == 0)
    {
        console.print("=1.清屏模式 [(关闭),软清屏,原生]");
    }
    else if(pref_clear_mode == 1)
    {
        console.print("=1.清屏模式 [关闭,(软清屏),原生]");
    }
    else
    {
        console.print("=1.清屏模式 [关闭,软清屏,(原生)]");
    }
}

// fn[596] row_pref_tips
function row_pref_tips()
{
    if(pref_tips)
    {
        console.print("=2.操作提示 [ON]");
    }
    else
    {
        console.print("=2.操作提示 [OFF]");
    }
}

