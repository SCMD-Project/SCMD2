// fn[282] menu_weapons -> scmd_weapons
function menu_weapons()
{
    screen_begin();
    reset_slots();
    console.print("================================");
    console.print("=|SCMD 2.0:\\\\菜单\\\\武器与装备");
    console.print("================================");
    console.print("=1.全部武器 [LOCAL/CHEATS]");
    console.print("=2.步枪");
    console.print("=3.狙击枪");
    console.print("=4.冲锋枪");
    console.print("=5.霰弹枪");
    console.print("=6.机枪");
    console.print("=7.手枪");
    console.print("=8.投掷物");
    console.print("=9.装备");
    console.print("=10.特殊物品 [LOCAL/CHEATS]");
    console.print("=11.快速整套装备");
    console.print("=12.补充当前武器弹药");
    console.print("=give 类功能通常需要本地 sv_cheats 1");
    console.print("================================");
    console.print("=0.返回");
    console.print("=00.刷新");
    console.print("=+序号.查看指令/用法");
