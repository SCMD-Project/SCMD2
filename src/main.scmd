// fn[190] preset_standard -> scmd_practice_standard
function preset_standard()
{
    command.exec("sv_cheats 1");
    command.exec("mp_warmup_end");
    command.exec("mp_limitteams 0");
    command.exec("mp_autoteambalance 0");
    command.exec("mp_roundtime 60");
    command.exec("mp_roundtime_defuse 60");
    command.exec("mp_roundtime_hostage 60");
    command.exec("mp_freezetime 0");
    command.exec("mp_buy_anywhere 1");
    command.exec("mp_buytime 9999");
    command.exec("mp_maxmoney 60000");
    command.exec("mp_startmoney 60000");
    command.exec("mp_afterroundmoney 60000");
    command.exec("mp_weapons_allow_typecount -1");
    command.exec("ammo_grenade_limit_total 6");
    command.exec("mp_ignore_round_win_conditions 1");
    command.exec("sv_infinite_ammo 2");
    command.exec("host_timescale 1");
    command.exec("bot_kick");
    command.exec("mp_restartgame 1");
    st_ammo = 2;
    st_timescale = 4;
    st_bot_stop = 0;
    st_bot_mimic = 0;
    command.exec("scmd_practice");
    if(pref_tips)
    {
        console.print("[SCMD] 标准跑图环境初始化完成");
    }
}

