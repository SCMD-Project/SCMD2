{
    if(st_fps == 2)
    {
        console.print("=1.FPS显示 [ON]");
    }
    else if(st_fps == 1)
    {
        console.print("=1.FPS显示 [OFF]");
    }
    else
    {
        console.print("=1.FPS显示 [?]");
    }
}

