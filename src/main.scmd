// fn[211] menu_main -> scmd_menu
function menu_main()
{
    screen_begin();
    reset_slots();
    console.print("================================");
    console.print("=|SCMD 2.0:\\\\菜单");
    console.print("================================");
    console.print("=指令:");
    console.print("=1.快捷指令");
    console.print("=2.全部命令");
    console.print("=3.武器与装备");
    console.print("=4.自定义指令");
    console.print("");
    console.print("=练习:");
    console.print("=5.快速跑图");
    console.print("=6.练习工具");
    console.print("=7.人机控制");
    console.print("=8.Demo与观战");
    console.print("");
    console.print("=设置:");
    console.print("=9.地图与会话");
    console.print("=10.显示与HUD");
    console.print("=11.准星与视角");
    console.print("=12.声音与语音");
    console.print("=13.按键与快捷键");
    console.print("=14.CFG与控制台");
    console.print("");
    console.print("=SCMD:");
    console.print("=15.首选项");
    console.print("=16.关于SCMD");
    console.print("");
    console.print("================================");
    console.print("=0.返回");
    console.print("=00.刷新");
    console.print("=+序号.查看指令/用法");
    console.print("================================");
    command.exec("alias 0 scmd_menu");
    command.exec("alias 00 scmd_menu");
    command.exec("alias 1 scmd_quick");
    command.exec("alias +1 scmd_h_1");
    command.exec("alias 2 scmd_commands");
    command.exec("alias +2 scmd_h_2");
    command.exec("alias 3 scmd_weapons");
    command.exec("alias +3 scmd_h_3");
    command.exec("alias 4 scmd_custom_menu");
    command.exec("alias +4 scmd_h_4");
    command.exec("alias 5 scmd_practice");
    command.exec("alias +5 scmd_h_5");
    command.exec("alias 6 scmd_practice_tools");
    command.exec("alias +6 scmd_h_6");
    command.exec("alias 7 scmd_bots");
    command.exec("alias +7 scmd_h_7");
    command.exec("alias 8 scmd_demo");
    command.exec("alias +8 scmd_h_8");
    command.exec("alias 9 scmd_map");
    command.exec("alias +9 scmd_h_9");
    command.exec("alias 10 scmd_display");
    command.exec("alias +10 scmd_h_10");
    command.exec("alias 11 scmd_crosshair_menu");
    command.exec("alias +11 scmd_h_11");
    command.exec("alias 12 scmd_sound");
    command.exec("alias +12 scmd_h_12");
    command.exec("alias 13 scmd_bind");
    command.exec("alias +13 scmd_h_13");
    command.exec("alias 14 scmd_cfg");
    command.exec("alias +14 scmd_h_14");
    command.exec("alias 15 scmd_preferences");
    command.exec("alias +15 scmd_h_15");
    command.exec("alias 16 scmd_about");
    command.exec("alias +16 scmd_h_16");
}

// fn[212] row_quick_fps
function row_quick_fps()
{
    if(st_fps == 2)
    {
        console.print("=13.FPS显示 [ON]");
    }
    else if(st_fps == 1)
    {
        console.print("=13.FPS显示 [OFF]");
    }
    else
    {
        console.print("=13.FPS显示 [?]");
    }
}

