// SCMD 2.0 BETA 3 SOURCE
// Hand-maintained modular layout. Migrated from tools/generate_scmd2.py output
// (SCMD-Project/SCMD2#1): public scmd_* entry points are `export function`
// stable aliases; there is no external source generator and no __scmd_fn index
// coupling. Function order across modules follows the original single file.

get "core.scmd";
get "toggles.scmd";
get "cycles.scmd";
get "rows.scmd";
get "actions.scmd";
get "menus.scmd";
get "catalog.scmd";
get "help.scmd";
get "bind.scmd";

// SCMD 2.0 runtime state.
// For game state mirrors: 0 = unknown, 1 = off, 2 = on.
u8 st_fps = 0;
u8 st_hud = 0;
u8 st_crosshair = 0;
u8 st_impacts = 0;
u8 st_trajectory = 0;
u8 st_showpos = 0;
u8 st_god = 0;
u8 st_bot_stop = 0;
u8 st_bot_mimic = 0;
u8 st_voice = 0;
u8 st_loopback = 0;
u8 st_mute_losefocus = 0;
u8 st_dot = 0;
u8 st_outline = 0;
u8 st_tcross = 0;
// ammo: 0 unknown, 1 off, 2 reload-mode, 3 infinite-without-reload.
u8 st_ammo = 0;
// Preset selectors: 0 = unknown unless a documented default is safe.
u8 st_timescale = 0;       // 0.1,0.25,0.5,1,2
u8 st_demo_speed = 0;      // 0.25,0.5,1,2,4
u8 st_cross_style = 0;
u8 st_cross_size = 0;
u8 st_cross_thickness = 0;
u8 st_cross_gap = 0;
u8 st_cross_color = 0;
u8 st_sniper_width = 0;
u8 st_view_fov = 0;         // 54,60,68
u8 st_view_preset = 0;
u8 st_volume = 0;           // 0,0.25,0.5,0.75,1
u8 st_menu_music = 0;
u8 st_mvp_music = 0;
u8 st_tensec = 0;
// 0 none, otherwise binding target id.
u8 bind_target = 0;

// clear mode: 0 none, 1 soft scroll clear, 2 native clear (delayed async).
u8 pref_clear_mode = 1;
bool pref_tips = true;

// Boot sequence.
function main()
{
    command.exec("alias scmd_custom1 scmd_custom_empty");
    command.exec("alias scmd_custom2 scmd_custom_empty");
    command.exec("alias scmd_custom3 scmd_custom_empty");
    command.exec("alias scmd_custom4 scmd_custom_empty");
    command.exec("alias scmd_custom5 scmd_custom_empty");
    command.exec("alias scmd_custom6 scmd_custom_empty");
    command.exec("alias scmd_custom7 scmd_custom_empty");
    command.exec("alias scmd_custom8 scmd_custom_empty");
    command.exec("execifexists Scmd/Custom");
    command.exec("scmd_menu");
}
