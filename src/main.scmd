// fn[664] menu_bind_preset -> scmd_bind_preset
function menu_bind_preset()
{
    screen_begin();
    reset_slots();
    console.print("================================");
    console.print("=|SCMD 2.0:\\\\按键与快捷键\\\\绑定预设命令");
    console.print("================================");
    console.print("=1.打开SCMD菜单");
    console.print("=2.打开快捷指令");
    console.print("=3.打开快速跑图");
    console.print("=4.打开练习工具");
    console.print("=5.打开人机控制");
    console.print("=6.打开武器菜单");
    console.print("=7.切换飞行");
    console.print("=8.重新投掷");
    console.print("=9.放置人机");
    console.print("=10.冻结/解除人机");
    console.print("=11.人机模仿");
    console.print("=12.清除人机");
    console.print("=13.切换FPS显示");
    console.print("=14.切换弹着点");
    console.print("=15.切换投掷轨迹");
    console.print("=16.切换位置显示");
    console.print("=17.循环无限弹药");
    console.print("=18.切换无敌");
    console.print("=19.清除烟雾");
    console.print("=20.重新开始回合");
    console.print("=21.结束热身");
    console.print("=22.Demo暂停/继续");
    console.print("=23.切换准星显示");
    console.print("=24.切换语音接收");
    console.print("================================");
    console.print("=0.返回");
    console.print("=00.刷新");
    console.print("=+序号.查看指令/用法");
    console.print("================================");
    command.exec("alias 0 scmd_bind");
    command.exec("alias 00 scmd_bind_preset");
    command.exec("alias 1 scmd_i_bind_target_1");
    command.exec("alias +1 scmd_h_276");
    command.exec("alias 2 scmd_i_bind_target_2");
    command.exec("alias +2 scmd_h_277");
    command.exec("alias 3 scmd_i_bind_target_3");
    command.exec("alias +3 scmd_h_278");
    command.exec("alias 4 scmd_i_bind_target_4");
    command.exec("alias +4 scmd_h_279");
    command.exec("alias 5 scmd_i_bind_target_5");
