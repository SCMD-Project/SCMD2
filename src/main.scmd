// fn[455] row_demo_speed
function row_demo_speed()
{
    if(st_demo_speed == 1)
    {
        console.print("=6.Demo速度 [(0.25),0.5,1,2,4]");
    }
    else if(st_demo_speed == 2)
    {
        console.print("=6.Demo速度 [0.25,(0.5),1,2,4]");
    }
    else if(st_demo_speed == 3)
    {
        console.print("=6.Demo速度 [0.25,0.5,(1),2,4]");
    }
    else if(st_demo_speed == 4)
    {
        console.print("=6.Demo速度 [0.25,0.5,1,(2),4]");
    }
    else if(st_demo_speed == 5)
    {
        console.print("=6.Demo速度 [0.25,0.5,1,2,(4)]");
    }
    else
    {
        console.print("=6.Demo速度 [0.25,0.5,1,2,4,(?)]");
    }
}

