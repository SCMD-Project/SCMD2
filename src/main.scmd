// fn[717] menu_bind_key -> scmd_bind_key
function menu_bind_key()
{
    screen_begin();
    reset_slots();
    console.print("================================");
    console.print("=|SCMD 2.0:\\\\按键与快捷键\\\\选择按键");
    console.print("================================");
    console.print("=1.F1");
    console.print("=2.F2");
    console.print("=3.F3");
    console.print("=4.F4");
    console.print("=5.F5");
    console.print("=6.F6");
    console.print("=7.F7");
    console.print("=8.F8");
    console.print("=9.F9");
    console.print("=10.F10");
    console.print("=11.F11");
    console.print("=12.F12");
    console.print("=13.Insert");
    console.print("=14.Delete");
    console.print("=15.Home");
    console.print("=16.End");
    console.print("=17.PageUp");
    console.print("=18.PageDown");
    console.print("=19.Mouse3");
    console.print("=20.Mouse4");
    console.print("=21.Mouse5");
    if(bind_target == 1)
    {
        console.print("=目标: 打开SCMD菜单");
    }
    else if(bind_target == 2)
    {
        console.print("=目标: 打开快捷指令");
    }
    else if(bind_target == 3)
    {
        console.print("=目标: 打开快速跑图");
    }
    else if(bind_target == 4)
    {
        console.print("=目标: 打开练习工具");
    }
    else if(bind_target == 5)
    {
        console.print("=目标: 打开人机控制");
    }
    else if(bind_target == 6)
    {
        console.print("=目标: 打开武器菜单");
    }
    else if(bind_target == 7)
    {
        console.print("=目标: 切换飞行");
    }
    else if(bind_target == 8)
    {
        console.print("=目标: 重新投掷");
    }
    else if(bind_target == 9)
    {
        console.print("=目标: 放置人机");
    }
    else if(bind_target == 10)
    {
        console.print("=目标: 冻结/解除人机");
    }
    else if(bind_target == 11)
    {
        console.print("=目标: 人机模仿");
    }
    else if(bind_target == 12)
    {
        console.print("=目标: 清除人机");
    }
    else if(bind_target == 13)
    {
        console.print("=目标: 切换FPS显示");
    }
    else if(bind_target == 14)
    {
        console.print("=目标: 切换弹着点");
    }
    else if(bind_target == 15)
    {
        console.print("=目标: 切换投掷轨迹");
    }
    else if(bind_target == 16)
    {
        console.print("=目标: 切换位置显示");
    }
    else if(bind_target == 17)
    {
        console.print("=目标: 循环无限弹药");
    }
    else if(bind_target == 18)
    {
        console.print("=目标: 切换无敌");
    }
    else if(bind_target == 19)
    {
        console.print("=目标: 清除烟雾");
    }
    else if(bind_target == 20)
    {
        console.print("=目标: 重新开始回合");
    }
    else if(bind_target == 21)
    {
        console.print("=目标: 结束热身");
    }
    else if(bind_target == 22)
    {
        console.print("=目标: Demo暂停/继续");
    }
    else if(bind_target == 23)
    {
        console.print("=目标: 切换准星显示");
    }
    else if(bind_target == 24)
    {
        console.print("=目标: 切换语音接收");
    }
    else if(bind_target == 25)
    {
        console.print("=目标: 自定义指令1");
    }
    else if(bind_target == 26)
    {
        console.print("=目标: 自定义指令2");
    }
    else if(bind_target == 27)
    {
        console.print("=目标: 自定义指令3");
    }
    else if(bind_target == 28)
    {
        console.print("=目标: 自定义指令4");
    }
    else if(bind_target == 29)
    {
        console.print("=目标: 自定义指令5");
    }
    else if(bind_target == 30)
    {
        console.print("=目标: 自定义指令6");
    }
    else if(bind_target == 31)
    {
        console.print("=目标: 自定义指令7");
    }
    else if(bind_target == 32)
    {
        console.print("=目标: 自定义指令8");
    }
    else
    {
        console.print("=目标: 未选择");
    }
    console.print("=选择按键会覆盖该键原有绑定");
    console.print("=SCMD 不会自动恢复被覆盖的旧绑定");
    console.print("================================");
    console.print("=0.返回");
    console.print("=00.刷新");
    console.print("=+序号.查看指令/用法");
    console.print("================================");
    command.exec("alias 0 scmd_bind");
    command.exec("alias 00 scmd_bind_key");
    command.exec("alias 1 scmd_i_bind_key_1");
    command.exec("alias +1 scmd_h_308");
    command.exec("alias 2 scmd_i_bind_key_2");
    command.exec("alias +2 scmd_h_309");
    command.exec("alias 3 scmd_i_bind_key_3");
    command.exec("alias +3 scmd_h_310");
    command.exec("alias 4 scmd_i_bind_key_4");
    command.exec("alias +4 scmd_h_311");
    command.exec("alias 5 scmd_i_bind_key_5");
    command.exec("alias +5 scmd_h_312");
    command.exec("alias 6 scmd_i_bind_key_6");
    command.exec("alias +6 scmd_h_313");
    command.exec("alias 7 scmd_i_bind_key_7");
    command.exec("alias +7 scmd_h_314");
    command.exec("alias 8 scmd_i_bind_key_8");
    command.exec("alias +8 scmd_h_315");
    command.exec("alias 9 scmd_i_bind_key_9");
    command.exec("alias +9 scmd_h_316");
    command.exec("alias 10 scmd_i_bind_key_10");
    command.exec("alias +10 scmd_h_317");
    command.exec("alias 11 scmd_i_bind_key_11");
    command.exec("alias +11 scmd_h_318");
    command.exec("alias 12 scmd_i_bind_key_12");
    command.exec("alias +12 scmd_h_319");
    command.exec("alias 13 scmd_i_bind_key_13");
    command.exec("alias +13 scmd_h_320");
    command.exec("alias 14 scmd_i_bind_key_14");
    command.exec("alias +14 scmd_h_321");
    command.exec("alias 15 scmd_i_bind_key_15");
    command.exec("alias +15 scmd_h_322");
    command.exec("alias 16 scmd_i_bind_key_16");
    command.exec("alias +16 scmd_h_323");
    command.exec("alias 17 scmd_i_bind_key_17");
    command.exec("alias +17 scmd_h_324");
    command.exec("alias 18 scmd_i_bind_key_18");
    command.exec("alias +18 scmd_h_325");
    command.exec("alias 19 scmd_i_bind_key_19");
    command.exec("alias +19 scmd_h_326");
    command.exec("alias 20 scmd_i_bind_key_20");
    command.exec("alias +20 scmd_h_327");
    command.exec("alias 21 scmd_i_bind_key_21");
    command.exec("alias +21 scmd_h_328");
}

