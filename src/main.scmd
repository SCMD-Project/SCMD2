// fn[253] menu_commands -> scmd_commands
function menu_commands()
{
    screen_begin();
    reset_slots();
    console.print("================================");
    console.print("=|SCMD 2.0:\\\\菜单\\\\全部命令");
    console.print("================================");
    console.print("=1.CFG与控制台");
    console.print("=2.按键与输入");
    console.print("=3.地图与会话");
    console.print("=4.游戏与回合");
    console.print("=5.练习与作弊");
    console.print("=6.人机");
    console.print("=7.武器与购买");
    console.print("=8.Demo与观战");
    console.print("=9.显示与HUD");
    console.print("=10.准星与视角");
    console.print("=11.声音与语音");
    console.print("=12.聊天与通信");
    console.print("=13.网络与状态");
    console.print("=14.截图/位置/记录");
    console.print("=15.Workshop与地图");
    console.print("=16.服务端与管理");
    console.print("=这是精选实用命令目录");
    console.print("=原始全集请在 CFG与控制台 中导出");
    console.print("================================");
    console.print("=0.返回");
    console.print("=00.刷新");
    console.print("=+序号.查看指令/用法");
    console.print("================================");
    command.exec("alias 0 scmd_menu");
    command.exec("alias 00 scmd_commands");
    command.exec("alias 1 scmd_cmd_cfg");
    command.exec("alias +1 scmd_h_33");
    command.exec("alias 2 scmd_cmd_bind");
    command.exec("alias +2 scmd_h_34");
    command.exec("alias 3 scmd_cmd_map");
    command.exec("alias +3 scmd_h_35");
    command.exec("alias 4 scmd_cmd_game");
    command.exec("alias +4 scmd_h_36");
    command.exec("alias 5 scmd_cmd_practice");
    command.exec("alias +5 scmd_h_37");
    command.exec("alias 6 scmd_cmd_bot");
    command.exec("alias +6 scmd_h_38");
    command.exec("alias 7 scmd_cmd_weapon");
    command.exec("alias +7 scmd_h_39");
    command.exec("alias 8 scmd_cmd_demo");
    command.exec("alias +8 scmd_h_40");
    command.exec("alias 9 scmd_cmd_display");
    command.exec("alias +9 scmd_h_41");
    command.exec("alias 10 scmd_cmd_cross");
    command.exec("alias +10 scmd_h_42");
    command.exec("alias 11 scmd_cmd_sound");
    command.exec("alias +11 scmd_h_43");
    command.exec("alias 12 scmd_cmd_chat");
