// fn[600] menu_preferences -> scmd_preferences
function menu_preferences()
{
    screen_begin();
    reset_slots();
    console.print("================================");
    console.print("=|SCMD 2.0:\\\\菜单\\\\首选项");
    console.print("================================");
    row_pref_clear();
    row_pref_tips();
    console.print("=3.恢复默认首选项");
    console.print("=默认使用软清屏，避免 CS2 原生 clear 时序导致菜单缺字");
    console.print("================================");
    console.print("=0.返回");
    console.print("=00.刷新");
    console.print("=+序号.查看指令/用法");
    console.print("================================");
    command.exec("alias 0 scmd_menu");
    command.exec("alias 00 scmd_preferences");
    command.exec("alias 1 scmd_pref_clear");
    command.exec("alias +1 scmd_h_268");
    command.exec("alias 2 scmd_pref_tips");
    command.exec("alias +2 scmd_h_269");
    command.exec("alias 3 scmd_pref_reset");
    command.exec("alias +3 scmd_h_270");
}

