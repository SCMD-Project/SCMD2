// fn[499] menu_display -> scmd_display
function menu_display()
{
    screen_begin();
    reset_slots();
    console.print("================================");
    console.print("=|SCMD 2.0:\\\\菜单\\\\显示与HUD");
    console.print("================================");
    row_display_fps();
    row_display_hud();
    row_display_showpos();
    row_display_impacts();
    row_display_trajectory();
    console.print("=6.网络状态");
    console.print("=7.第一人称");
    console.print("=8.第三人称 [CHEATS]");
    console.print("=9.切换雷达缩放");
    console.print("================================");
    console.print("=0.返回");
    console.print("=00.刷新");
    console.print("=+序号.查看指令/用法");
    console.print("================================");
    command.exec("alias 0 scmd_menu");
    command.exec("alias 00 scmd_display");
    command.exec("alias 1 scmd_i_display_fps");
    command.exec("alias +1 scmd_h_221");
    command.exec("alias 2 scmd_i_display_hud");
    command.exec("alias +2 scmd_h_222");
    command.exec("alias 3 scmd_i_display_showpos");
    command.exec("alias +3 scmd_h_223");
    command.exec("alias 4 scmd_i_display_impacts");
    command.exec("alias +4 scmd_h_224");
    command.exec("alias 5 scmd_i_display_trajectory");
    command.exec("alias +5 scmd_h_225");
    command.exec("alias 6 scmd_display_net");
    command.exec("alias +6 scmd_h_226");
    command.exec("alias 7 scmd_i_firstperson");
    command.exec("alias +7 scmd_h_227");
    command.exec("alias 8 scmd_i_thirdperson");
    command.exec("alias +8 scmd_h_228");
    command.exec("alias 9 scmd_i_radar");
    command.exec("alias +9 scmd_h_229");
}

