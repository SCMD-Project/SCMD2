// fn[512] row_cross_main
function row_cross_main()
{
    if(st_crosshair == 2)
    {
        console.print("=1.准星显示 [ON]");
    }
    else if(st_crosshair == 1)
    {
        console.print("=1.准星显示 [OFF]");
    }
    else
    {
        console.print("=1.准星显示 [?]");
    }
}

// fn[513] row_cross_style
function row_cross_style()
{
    if(st_cross_style == 1)
    {
        console.print("=2.准星样式 [(0),1,2,3,4,5]");
    }
    else if(st_cross_style == 2)
    {
        console.print("=2.准星样式 [0,(1),2,3,4,5]");
    }
    else if(st_cross_style == 3)
    {
        console.print("=2.准星样式 [0,1,(2),3,4,5]");
    }
    else if(st_cross_style == 4)
    {
        console.print("=2.准星样式 [0,1,2,(3),4,5]");
    }
    else if(st_cross_style == 5)
    {
        console.print("=2.准星样式 [0,1,2,3,(4),5]");
    }
    else if(st_cross_style == 6)
    {
        console.print("=2.准星样式 [0,1,2,3,4,(5)]");
    }
    else
    {
        console.print("=2.准星样式 [0,1,2,3,4,5,(?)]");
    }
}

