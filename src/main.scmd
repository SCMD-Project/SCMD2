// fn[507] display_net -> scmd_display_net
function display_net()
{
    screen_begin();
    reset_slots();
    console.print("================================");
    console.print("=|SCMD 2.0:\\\\显示与HUD\\\\网络状态");
    console.print("================================");
    console.print("=1.net_status");
    console.print("=2.net_channels");
    console.print("=3.status");
    console.print("=4.cl_ticktiming");
    console.print("================================");
    console.print("=0.返回");
    console.print("=00.刷新");
    console.print("=+序号.查看指令/用法");
    console.print("================================");
    command.exec("alias 0 scmd_display");
    command.exec("alias 00 scmd_display_net");
    command.exec("alias 1 scmd_i_net_status");
    command.exec("alias +1 scmd_h_230");
    command.exec("alias 2 scmd_i_net_channels");
    command.exec("alias +2 scmd_h_231");
    command.exec("alias 3 scmd_i_status");
    command.exec("alias +3 scmd_h_232");
    command.exec("alias 4 scmd_i_ticktiming");
    command.exec("alias +4 scmd_h_233");
}

