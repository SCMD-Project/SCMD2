// fn[415] row_practice_timescale
function row_practice_timescale()
{
    if(st_timescale == 1)
    {
        console.print("=4.时间流速 [(0.1),0.25,0.5,1,2]");
    }
    else if(st_timescale == 2)
    {
        console.print("=4.时间流速 [0.1,(0.25),0.5,1,2]");
    }
    else if(st_timescale == 3)
    {
        console.print("=4.时间流速 [0.1,0.25,(0.5),1,2]");
    }
    else if(st_timescale == 4)
    {
        console.print("=4.时间流速 [0.1,0.25,0.5,(1),2]");
    }
    else if(st_timescale == 5)
    {
        console.print("=4.时间流速 [0.1,0.25,0.5,1,(2)]");
    }
    else
    {
        console.print("=4.时间流速 [0.1,0.25,0.5,1,2,(?)]");
    }
}

